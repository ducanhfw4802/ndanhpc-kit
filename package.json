{
  "name": "ndanhpc-kit",
  "version": "2026.10.17",
  "description": "NDANHPC Kit - Antigravity-native AI Agent Capability Toolkit",
  "author": "ndanhpc",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "scripts": {
    "check:agents": "python3 .agents/scripts/validate_kit.py",
    "check:antigravity": "node .agents/hooks/antigravity-doctor.mjs",
    "test:antigravity": "node .agents/hooks/tests/antigravity.test.mjs",
    "test:toolkit": "python3 .agents/scripts/tests/test_toolkit.py",
    "verify": "python3 .agents/scripts/verify_all.py",
    "manifest": "python3 .agents/scripts/generate_manifest.py",
    "deps": "python3 .agents/scripts/dependency_graph.py",
    "generate:agents": "npm run manifest && npm run deps",
    "build:antigravity-plugin": "node .agents/hooks/build-plugin.mjs",
    "web": "python3 -m http.server 3000 --directory web",
    "tui": "python3 .agents/scripts/ndanhpc_cli.py",
    "update": "bash install.sh update",
    "uninstall": "bash install.sh uninstall"
  }
}
